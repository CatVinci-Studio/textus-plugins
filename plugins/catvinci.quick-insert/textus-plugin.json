{
  "id": "catvinci.quick-insert",
  "name": "%name%",
  "version": "0.4.3",
  "publisher": "catvinci",
  "author": "CatVinci Studio",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/textus-plugins",
  "engines": {
    "textus": ">=1.3.10"
  },
  "platforms": ["desktop", "ios"],
  "main": [
    "lib/folder-paths.js",
    "lib/link-style.js",
    "lib/conventions.js",
    "dates.js",
    "emoji.js",
    "host.js"
  ],
  "permissions": [
    "files.read",
    "editor.read",
    "editor.write",
    "ai.tools"
  ],
  "activationEvents": [
    "onEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "catvinci.quick-insert.h1",
        "title": "%h1%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "h1"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.h2",
        "title": "%h2%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "h2"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.h3",
        "title": "%h3%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "h3"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.text",
        "title": "%text%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "paragraph"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.bullet",
        "title": "%bullet%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "bullet-list"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.numbered",
        "title": "%numbered%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "ordered-list"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.task",
        "title": "%task%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "task-list"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.quote",
        "title": "%quote%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "blockquote"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.code",
        "title": "%code%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "code-block"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.math",
        "title": "%math%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "math-block"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.table",
        "title": "%table%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "table"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.divider",
        "title": "%divider%",
        "runs": {
          "command": "textus.insertBlock",
          "args": [
            "rule"
          ]
        }
      },
      {
        "command": "catvinci.quick-insert.callout",
        "title": "%callout%"
      },
      {
        "command": "catvinci.quick-insert.turnInto",
        "title": "%turnInto%"
      }
    ],
    "menus": {
      "editor/slash": [
        {
          "command": "catvinci.quick-insert.h1"
        },
        {
          "command": "catvinci.quick-insert.h2"
        },
        {
          "command": "catvinci.quick-insert.h3"
        },
        {
          "command": "catvinci.quick-insert.text"
        },
        {
          "command": "catvinci.quick-insert.bullet"
        },
        {
          "command": "catvinci.quick-insert.numbered"
        },
        {
          "command": "catvinci.quick-insert.task"
        },
        {
          "command": "catvinci.quick-insert.quote"
        },
        {
          "command": "catvinci.quick-insert.code"
        },
        {
          "command": "catvinci.quick-insert.math"
        },
        {
          "command": "catvinci.quick-insert.table"
        },
        {
          "command": "catvinci.quick-insert.divider"
        },
        {
          "command": "catvinci.quick-insert.callout"
        },
        {
          "command": "catvinci.quick-insert.turnInto"
        }
      ]
    },
    "completions": [
      {
        "id": "catvinci.quick-insert.emoji",
        "where": "text",
        "pattern": "(?<=^|\\s):[\\p{L}\\p{N}_+-]{2,30}"
      },
      {
        "id": "catvinci.quick-insert.at",
        "where": "text",
        "pattern": "(?<=^|[\\s(（])@[^\\s@]{0,20}"
      }
    ],
    "settings": [
      {
        "key": "insert",
        "type": "enum",
        "default": "date",
        "title": "%insert%",
        "options": [
          {
            "value": "date",
            "label": "%asDate%"
          },
          {
            "value": "link",
            "label": "%asLink%"
          }
        ]
      }
    ],
    "aiTools": [
      {
        "name": "parse_date",
        "description": "%tool.parse_date%",
        "parameters": {
          "type": "object",
          "required": [
            "phrase"
          ],
          "properties": {
            "phrase": {
              "type": "string",
              "description": "A day in words: today, tomorrow, friday, next wednesday, in 10 days, 下周五, 3天后, 来週月曜日..."
            },
            "today": {
              "type": "string",
              "description": "The day to count from, YYYY-MM-DD; today when left out."
            }
          }
        }
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Quick Insert",
      "description": "Type / for headings, lists, tables, formulas and more, : for emoji, @ for a date (@tomorrow, @next friday), and turn a paragraph into another kind of block.",
      "turnPlaceholder": "Turn this paragraph into",
      "h1": "Heading 1",
      "h2": "Heading 2",
      "h3": "Heading 3",
      "text": "Text",
      "bullet": "Bulleted list",
      "numbered": "Numbered list",
      "task": "To-do list",
      "quote": "Quote",

{
  "flags": "i",
  "rules": [
    { "token": "comment", "match": "^\\s*!.*" },
    { "token": "string", "match": "\\b(?:description|remark)\\s.*" },
    { "token": "string", "match": "\"[^\"]*\"" },
    {
      "token": "type",
      "match": "\\b(?:GigabitEthernet|FastEthernet|TenGigabitEthernet|TwentyFiveGigE|FortyGigabitEthernet|HundredGigE|Ethernet|Serial|Loopback|Tunnel|Vlan|Port-channel|Dialer|Virtual-Template|BVI|Null|Management|mgmt|Gi|Fa|Te|Twe|Fo|Hu|Eth|Et|Se|Lo|Tu|Po|Vl)\\d+(?:/\\d+){0,3}(?:\\.\\d+)?(?::\\d+)?\\b"
    },
    { "token": "number", "match": "\\b\\d{1,3}(?:\\.\\d{1,3}){3}(?:/\\d{1,2})?\\b" },
    { "token": "number", "match": "\\b[0-9a-f]{4}\\.[0-9a-f]{4}\\.[0-9a-f]{4}\\b" },
    { "token": "number", "match": "\\b[0-9a-f]{1,4}(?::[0-9a-f]{0,4}){2,7}(?:/\\d{1,3})?" },
    {
      "token": "keyword",
      "match": "\\b(?:access-list|access-group|access-class|remote-as|router-id|passive-interface|default-gateway|default-router|default-information|excluded-address|domain-name|name-server|helper-address|snmp-server|tacacs-server|radius-server|spanning-tree|channel-group|port-security|storm-control|class-map|policy-map|service-policy|route-map|prefix-list|mac-address|exec-timeout|new-model|running-config|startup-config|config-register|ip-address|key-string)\\b"
    },
    {
      "token": "keyword",
      "match": "\\b(?:interface|ip|ipv6|address|router|ospf|ospfv3|eigrp|bgp|rip|isis|network|area|neighbor|redistribute|summary-address|permit|deny|any|host|eq|neq|gt|lt|range|established|log|shutdown|no|hostname|vlan|name|switchport|mode|access|trunk|allowed|native|encapsulation|dot1q|enable|secret|password|service|line|con|vty|aux|login|local|transport|input|output|username|privilege|portfast|bpduguard|standby|vrrp|preempt|priority|track|nat|inside|outside|overload|pool|route|dhcp|ntp|server|logging|community|crypto|key|generate|rsa|isakmp|ipsec|policy|match|set|version|exit|end|write|memory|copy|duplex|speed|auto|full|half|mtu|bandwidth|clock|rate|banner|motd|aaa|authentication|authorization|accounting|extended|standard|cdp|lldp|run|tunnel|source|destination|keepalive|maximum|violation|sticky|arp|boot|system|vrf|forwarding|unicast-routing|routing|negotiation|description|remark)\\b"
    },
    {
      "token": "constant",
      "match": "\\b(?:tcp|udp|icmp|esp|gre|ahp|pim|www|http|https|ftp|ftp-data|telnet|ssh|domain|bootps|bootpc|tftp|snmp|smtp|pop3|echo|echo-reply|unreachable)\\b"
    },
    { "token": "number", "match": "\\b\\d+\\b" }
  ]
}

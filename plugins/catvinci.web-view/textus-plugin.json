{
  "id": "catvinci.web-view",
  "name": "%name%",
  "version": "1.0.2",
  "publisher": "catvinci",
  "author": "CatVinci Studio",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/textus-plugins",
  "engines": {
    "textus": "^1.3.0"
  },
  "main": "host.js",
  "permissions": ["network:*", "document.read"],
  "contributes": {
    "commands": [
      {
        "command": "catvinci.web-view.open",
        "title": "%open%"
      },
      {
        "command": "catvinci.web-view.openSelection",
        "title": "%openSelection%"
      },
      {
        "command": "catvinci.web-view.home",
        "title": "%home%"
      }
    ],
    "menus": {
      "app/plugins": [
        {
          "command": "catvinci.web-view.open"
        },
        {
          "command": "catvinci.web-view.home"
        }
      ],
      "editor/context": [
        {
          "command": "catvinci.web-view.openSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "settings": [
      {
        "key": "home",
        "type": "string",
        "default": "https://en.wikipedia.org",
        "title": "%homeSetting%"
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Web View",
      "description": "Open web pages in a tab beside your notes.",
      "open": "Open a Web Page…",
      "openSelection": "Open the Selected Link in a Tab",
      "home": "Open the Home Page",
      "homeSetting": "Home page",
      "prompt": "Web address"
    },
    "zh": {
      "name": "网页视图",
      "description": "在笔记旁边的标签页里打开网页。",
      "open": "打开网页…",
      "openSelection": "在标签页中打开选中的链接",
      "home": "打开主页",
      "homeSetting": "主页",
      "prompt": "网址"
    },
    "zh-Hant": {
      "name": "網頁檢視",
      "description": "在筆記旁邊的分頁中開啟網頁。",
      "open": "開啟網頁…",
      "openSelection": "在分頁中開啟選取的連結",
      "home": "開啟首頁",
      "homeSetting": "首頁",
      "prompt": "網址"
    },
    "ja": {
      "name": "ウェブビュー",
      "description": "ノートの隣のタブでウェブページを開きます。",
      "open": "ウェブページを開く…",
      "openSelection": "選択したリンクをタブで開く",
      "home": "ホームページを開く",
      "homeSetting": "ホームページ",
      "prompt": "ウェブアドレス"
    },
    "ko": {
      "name": "웹 보기",
      "description": "노트 옆 탭에서 웹 페이지를 엽니다.",
      "open": "웹 페이지 열기…",
      "openSelection": "선택한 링크를 탭에서 열기",
      "home": "홈페이지 열기",
      "homeSetting": "홈페이지",
      "prompt": "웹 주소"
    },
    "es": {
      "name": "Vista web",
      "description": "Abre páginas web en una pestaña junto a tus notas.",
      "open": "Abrir una página web…",
      "openSelection": "Abrir el enlace seleccionado en una pestaña",
      "home": "Abrir la página de inicio",
      "homeSetting": "Página de inicio",
      "prompt": "Dirección web"
    },
    "fr": {
      "name": "Vue web",
      "description": "Ouvrez des pages web dans un onglet à côté de vos notes.",
      "open": "Ouvrir une page web…",
      "openSelection": "Ouvrir le lien sélectionné dans un onglet",
      "home": "Ouvrir la page d’accueil",
      "homeSetting": "Page d’accueil",
      "prompt": "Adresse web"
    },
    "de": {
      "name": "Webansicht",
      "description": "Öffne Webseiten in einem Tab neben deinen Notizen.",
      "open": "Webseite öffnen…",

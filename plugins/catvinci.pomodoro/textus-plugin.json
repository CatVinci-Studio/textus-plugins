{
  "id": "catvinci.pomodoro",
  "name": "%name%",
  "version": "0.1.0",
  "publisher": "catvinci",
  "author": "CatVinci Studio",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/textus-plugins",
  "engines": {
    "textus": ">=1.3.10"
  },
  "platforms": [
    "desktop"
  ],
  "main": [
    "timer.js",
    "host.js"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "permissions": [
    "notifications"
  ],
  "contributes": {
    "commands": [
      {
        "command": "catvinci.pomodoro.toggle",
        "title": "%toggle%"
      },
      {
        "command": "catvinci.pomodoro.startPause",
        "title": "%startPause%"
      },
      {
        "command": "catvinci.pomodoro.skip",
        "title": "%skip%"
      },
      {
        "command": "catvinci.pomodoro.reset",
        "title": "%reset%"
      }
    ],
    "menus": {
      "app/plugins": [
        {
          "command": "catvinci.pomodoro.toggle"
        },
        {
          "command": "catvinci.pomodoro.startPause"
        }
      ],
      "floating/context": [
        {
          "command": "catvinci.pomodoro.skip",
          "when": "view == catvinci.pomodoro.timer"
        },
        {
          "command": "catvinci.pomodoro.reset",
          "when": "view == catvinci.pomodoro.timer"
        }
      ]
    },
    "floatingViews": [
      {
        "id": "catvinci.pomodoro.timer",
        "title": "%timer%",
        "width": 140,
        "height": 140,
        "place": "either"
      }
    ],
    "settings": [
      {
        "key": "focus",
        "type": "number",
        "default": 25,
        "title": "%focusMinutes%"
      },
      {
        "key": "rest",
        "type": "number",
        "default": 5,
        "title": "%restMinutes%"
      }
    ]
  },
  "l10n": {

{
  "id": "catvinci.pdf-viewer",
  "name": "%name%",
  "version": "0.1.0",
  "publisher": "catvinci",
  "author": "CatVinci Studio",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/textus-plugins",
  "engines": {
    "textus": ">=1.3.0-beta.2"
  },
  "main": "host.js",
  "permissions": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "catvinci.pdf-viewer.pdf",
        "displayName": "%name%",
        "filenamePatterns": [
          "*.pdf"
        ]
      }
    ],
    "settings": [
      {
        "key": "zoom",
        "type": "enum",
        "default": "fit",
        "title": "%zoom%",
        "options": [
          {
            "value": "fit",
            "label": "%zoomFit%"
          },
          {
            "value": "100",
            "label": "100%"
          }
        ]
      }
    ]
  },
  "l10n": {
    "en": {

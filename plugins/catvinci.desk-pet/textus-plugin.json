{
  "id": "catvinci.desk-pet",
  "name": "%name%",
  "version": "0.1.0",
  "publisher": "catvinci",
  "author": "CatVinci Studio",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/textus-plugins",
  "engines": {
    "textus": ">=1.3.6"
  },
  "platforms": [
    "desktop",
    "ios"
  ],
  "main": [
    "host.js"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:catvinci.desk-pet.toggle",
    "onCommand:catvinci.desk-pet.switch"
  ],
  "permissions": [],
  "contributes": {
    "commands": [
      {
        "command": "catvinci.desk-pet.toggle",
        "title": "%toggle%"
      },
      {
        "command": "catvinci.desk-pet.switch",
        "title": "%switch%"
      }
    ],
    "menus": {
      "app/plugins": [
        {
          "command": "catvinci.desk-pet.toggle"
        }
      ],
      "floating/context": [
        {
          "command": "catvinci.desk-pet.switch",
          "when": "view == catvinci.desk-pet.pet"
        }
      ]
    },
    "floatingViews": [
      {
        "id": "catvinci.desk-pet.pet",
        "title": "%pet%",
        "width": 180,
        "height": 200,
        "place": "either"
      }
    ],
    "settings": [
      {
        "key": "character",
        "type": "enum",
        "default": "auto",
        "title": "%character%",
        "options": [
          {
            "value": "auto",
            "label": "%auto%"
          },
          {
            "value": "textus",
            "label": "%textus%"
          },
          {
            "value": "claude",
            "label": "%claude%"
          },
          {
            "value": "gpt",
            "label": "%gpt%"
          },
          {
            "value": "gemini",
            "label": "%gemini%"
          },
          {
            "value": "deepseek",
            "label": "%deepseek%"
          },
          {
            "value": "kimi",
            "label": "%kimi%"
          },
          {
            "value": "qwen",
            "label": "%qwen%"
          },
          {
            "value": "doubao",
            "label": "%doubao%"
          },
          {
            "value": "glm",
            "label": "%glm%"
          },
          {
            "value": "minimax",
            "label": "%minimax%"
          },
          {
            "value": "grok",
            "label": "%grok%"
          },
          {
            "value": "wenxin",
            "label": "%wenxin%"
          }
        ]
      },
      {
        "key": "bubbles",
        "type": "boolean",
        "default": true,
        "title": "%bubbles%"
      },
      {
        "key": "night",
        "type": "boolean",
        "default": true,
        "title": "%night%"
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Desk Pet",
      "description": "A chibi companion that floats on your desktop or in the window while you write: Textus-chan, or the LLM-chan of the model Textus AI is using. She writes when you type, dozes when you stop, cheers when you save and leans in when Textus AI is at work.",
      "toggle": "Show or Hide the Desk Pet",
      "pet": "Desk Pet",
      "character": "Who keeps you company",
      "auto": "Follow Textus AI's model",
      "bubbles": "Speech bubbles",
      "night": "Remind me to rest late at night",
      "textus": "Textus-chan",
      "claude": "Claude-chan",
      "gpt": "GPT-chan",
      "gemini": "Gemini-chan",
      "deepseek": "DeepSeek-chan",
      "kimi": "Kimi-chan",
      "qwen": "Qwen-chan",
      "doubao": "Doubao-chan",
      "glm": "GLM-chan",
      "minimax": "MiniMax-chan",
      "grok": "Grok-chan",
      "wenxin": "ERNIE-chan",
      "switch": "Switch Character…",
      "current": "now"
    },
